{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moodboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5180,
      "autoPort": true
    },
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web",
        "--port",
        "5181"
      ],
      "port": 5181
    },
    {
      "name": "website-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        ".vercel/output/static",
        "--port",
        "5182"
      ],
      "port": 5182
    }
  ]
}